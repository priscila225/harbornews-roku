<?xml version="1.0" encoding="utf-8" ?>
<component name="ArticleDetailPage" extends="PageBase">
    <interface>
        <field id="articleId" type="string" alwaysNotify="true" onChange="onArticleIdChanged" />
    </interface>
    <script type="text/brightscript" uri="ArticleDetailPage.bs" />
    <children>
        <Label id="title" translation="[40,20]" width="1200" font="font:LargeBoldSystemFont" />
        <WeatherStrip id="weatherStrip" translation="[40,70]" />
        <Label id="temperature" translation="[700,70]" width="500" font="font:SmallSystemFont" />
        <Label id="body" translation="[40,120]" width="1200" height="260" wrap="true" font="font:SmallSystemFont" />
        <Label id="spinner" translation="[40,380]" width="400" text="Loading related stories..." />
        <MarkupList
            id="related"
            translation="[40,420]"
            itemComponentName="ArticleTile"
            itemSize="[1200,90]"
            numRows="3" />
    </children>
</component>
